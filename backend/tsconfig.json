{
  "compilerOptions": {
    "module": "NodeNext",
    "resolveJsonModule": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "../",
    "incremental": true,
    "skipLibCheck": true,
    "composite": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@dbstats/shared/*": [
        "../shared/*"
      ]
    },
    "strict": false,
    "types": [
      "jest",
      "node"
    ],
    "moduleResolution": "NodeNext",
    "esModuleInterop": true
  },
  "include": [
    "./src",
    "../shared",
    "jest.config.ts",
    "tsconfig.json",
    "test",
    "package.json"
  ]
}
